page 42 (
    name: PR Lines
    alias: PR-LINES
    title: PR Lines
    pageGroup: @procurement
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region pr-lines (
        name: PR Lines
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select line_id, pr_no, pr_status, line_no, item_code, item_name, uom, qty, unit_price, line_amount, notes
                  from pur_requisition_line_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 43
                items: {
                    P43_LINE_ID: \#LINE_ID#\
                }
                clearCache: 43
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column LINE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PR_NO (
            type: plainText
            heading {
                heading: No. PR
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PR_STATUS (
            type: plainText
            heading {
                heading: Status PR
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column LINE_NO (
            type: plainText
            heading {
                heading: Baris
                alignment: end
            }
            layout {
                sequence: 4
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Kode Item
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ITEM_NAME (
            type: plainText
            heading {
                heading: Nama Item
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: UoM
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column QTY (
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column UNIT_PRICE (
            type: plainText
            heading {
                heading: Harga Satuan
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column LINE_AMOUNT (
            type: plainText
            heading {
                heading: Jumlah
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column NOTES (
            type: plainText
            heading {
                heading: Catatan
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        savedReport 42001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PR_NO (
                sequence: 1
            )

            displayColumn PR_STATUS (
                sequence: 2
            )

            displayColumn LINE_NO (
                sequence: 3
            )

            displayColumn ITEM_CODE (
                sequence: 4
            )

            displayColumn ITEM_NAME (
                sequence: 5
            )

            displayColumn UOM (
                sequence: 6
            )

            displayColumn QTY (
                sequence: 7
            )

            displayColumn UNIT_PRICE (
                sequence: 8
            )

            displayColumn LINE_AMOUNT (
                sequence: 9
            )

            displayColumn NOTES (
                sequence: 10
            )

            sort (
                column: PR_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @pr-lines
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 43
                clearCache: 43
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @pr-lines
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @pr-lines
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
