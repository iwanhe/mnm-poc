        }
    )

    pageItem P21_NOTES (
        type: textarea
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 240
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @job-order
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P21_JOB_ID is not null and nvl(:P21_STATUS,'DRAFT') = 'DRAFT'
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P21_JOB_ID is not null and nvl(:P21_STATUS,'DRAFT') not in ('SUBMITTED','CLOSED','CANCELLED')
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P21_JOB_ID is null
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Approval
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ajukan dokumen ini untuk approval? Setelah diajukan dokumen terkunci.
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P21_JOB_ID is not null and nvl(:P21_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation customer-required-for-mto (
        name: Customer wajib untuk MTO
        execution {
            sequence: 10
        }
        validation {
            type: expression
            plsqlExpression: :P21_JOB_TYPE = 'STOCK' or :P21_CUSTOMER_ID is not null
        }
        error {
            errorMessage: Customer wajib diisi untuk job Make to Order.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P21_CUSTOMER_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,SUBMIT
        }
    )

    process initialize-form (
        name: Initialize form Job Order
        type: formInitialization
        formRegion: @job-order
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900021001
        }
    )

    process process-form (
        name: Process form Job Order
        type: formAutoRowProcessing
        formRegion: @job-order
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900021002
        }
    )

    process submit-for-approval (
        name: Submit for Approval
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                mbms_approval.submit(p_doc_type => 'JO', p_doc_id => :P21_JOB_ID);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokumen diajukan untuk approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
        advanced {
            executionMappingIdentifier: 900021003
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE,SUBMIT
        }
        advanced {
            executionMappingIdentifier: 900021004
        }
    )

)
