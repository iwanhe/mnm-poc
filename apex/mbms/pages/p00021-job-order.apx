page 21 (
    name: Job Order
    alias: JOB-ORDER
    title: Job Order
    pageGroup: @printing
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @printing-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region job-order (
        name: Job Order
        type: form
        source {
            location: localDatabase
            tableName: PRT_JOB_ORDER
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P21_JOB_ID (
        type: hidden
        layout {
            sequence: 5
            region: @job-order
            slot: regionBody
        }
        source {
            formRegion: @job-order
            column: JOB_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P21_JOB_NO (
        type: displayOnly
        label {
            label: No. Job Order
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @job-order
            column: JOB_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P21_STATUS (
        type: selectList
        label {
            label: Status
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @doc-status
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 20
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @job-order
            column: STATUS
            dataType: varchar2
        }
        default {
            type: static
            staticValue: DRAFT
        }
        readOnly {
            type: expression
            plsqlExpression: nvl(:P21_STATUS,'DRAFT') not in ('APPROVED','IN_PROGRESS','COMPLETED')
        }
        help {
            inlineHelpText: Setelah approved: ubah ke IN_PROGRESS / COMPLETED / CLOSED. Status hanya berubah lewat Submit for Approval / Approval Inbox.
        }
    )

    pageItem P21_BU_ID (
        type: hidden
        layout {
            sequence: 30
            region: @job-order
            slot: regionBody
        }
        source {
            formRegion: @job-order
            column: BU_ID
            dataType: number
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select bu_id from mdm_business_unit where bu_code = 'PRT'
        }
    )

    pageItem P21_JOB_TYPE (
        type: selectList
        label {
            label: Tipe Produksi (D-02)
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @job-types
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 40
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @job-order
            column: JOB_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MTO
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P21_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P21_CUSTOMER_ID (
        type: selectList
        label {
            label: Customer
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @customers
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 50
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @job-order
            column: CUSTOMER_ID
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P21_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
        help {
            inlineHelpText: Wajib untuk Make to Order.
        }
    )

    pageItem P21_PRODUCT_DESC (
        type: textarea
        label {
            label: Produk / Spesifikasi
            alignment: right
        }
        layout {
            sequence: 60
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            valueRequired: true
            maxLength: 500
        }
        source {
            formRegion: @job-order
            column: PRODUCT_DESC
            dataType: varchar2
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P21_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P21_QTY_ORDER (
        type: numberField
        label {
            label: Qty Order
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 1
        }
        layout {
            sequence: 70
            region: @job-order
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @job-order
            column: QTY_ORDER
            dataType: number
        }
        readOnly {
            type: expression
            plsqlExpression: not (nvl(:P21_STATUS,'DRAFT') in ('DRAFT','REJECTED'))
        }
    )

    pageItem P21_UPS_PER_SHEET (
        type: numberField
        label {
            label: Imposition (up per lembar)
            alignment: right
