page 33 (
    name: WBS Budget
    alias: WBS
    title: WBS Budget
    pageGroup: @engineering
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @engineering-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region wbs (
        name: WBS Budget
        type: form
        source {
            location: localDatabase
            tableName: PRJ_WBS
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P33_WBS_ID (
        type: hidden
        layout {
            sequence: 5
            region: @wbs
            slot: regionBody
        }
        source {
            formRegion: @wbs
            column: WBS_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P33_PROJECT_ID (
        type: selectList
        label {
            label: Proyek (DRAFT/REJECTED)
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @draft-projects
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 10
            region: @wbs
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @wbs
            column: PROJECT_ID
            dataType: number
        }
    )

    pageItem P33_WBS_CODE (
        type: textField
        label {
            label: Kode WBS
            alignment: right
        }
        layout {
            sequence: 20
            region: @wbs
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 20
        }
        source {
            formRegion: @wbs
            column: WBS_CODE
            dataType: varchar2
        }
    )

    pageItem P33_WBS_NAME (
        type: textField
        label {
            label: Aktivitas
            alignment: right
        }
        layout {
            sequence: 30
            region: @wbs
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @wbs
            column: WBS_NAME
            dataType: varchar2
        }
    )

    pageItem P33_COST_CATEGORY (
        type: selectList
        label {
            label: Kategori Biaya
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @cost-categories
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 40
            region: @wbs
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @wbs
            column: COST_CATEGORY
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MATERIAL
        }
    )

    pageItem P33_BUDGET_AMOUNT (
        type: numberField
        label {
            label: Budget
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 50
            region: @wbs
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @wbs
            column: BUDGET_AMOUNT
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P33_WBS_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P33_WBS_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P33_WBS_ID is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form WBS Budget
        type: formInitialization
        formRegion: @wbs
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 900033001
        }
    )

    process process-form (
        name: Process form WBS Budget
        type: formAutoRowProcessing
        formRegion: @wbs
        execution {
            sequence: 10
        }
        advanced {
            executionMappingIdentifier: 900033002
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
        advanced {
            executionMappingIdentifier: 900033003
        }
    )

)
