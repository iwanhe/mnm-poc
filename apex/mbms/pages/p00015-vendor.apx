page 15 (
    name: Vendor
    alias: VENDOR
    title: Vendor
    pageGroup: @master-data
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @master-data-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region vendor (
        name: Vendor
        type: form
        source {
            location: localDatabase
            tableName: MDM_VENDOR
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P15_VENDOR_ID (
        type: hidden
        layout {
            sequence: 5
            region: @vendor
            slot: regionBody
        }
        source {
            formRegion: @vendor
            column: VENDOR_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P15_VENDOR_CODE (
        type: textField
        label {
            label: Kode Vendor
            alignment: right
        }
        layout {
            sequence: 10
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @vendor
            column: VENDOR_CODE
            dataType: varchar2
        }
    )

    pageItem P15_VENDOR_NAME (
        type: textField
        label {
            label: Nama Vendor
            alignment: right
        }
        layout {
            sequence: 20
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @vendor
            column: VENDOR_NAME
            dataType: varchar2
        }
    )

    pageItem P15_VENDOR_TYPE (
        type: selectList
        label {
            label: Tipe Vendor
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @vendor-types
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 30
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @vendor
            column: VENDOR_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: GOODS
        }
    )

    pageItem P15_NPWP (
        type: textField
        label {
            label: NPWP
            alignment: right
        }
        layout {
            sequence: 40
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 30
        }
        source {
            formRegion: @vendor
            column: NPWP
            dataType: varchar2
        }
    )

    pageItem P15_ADDRESS (
        type: textarea
        label {
            label: Alamat
            alignment: right
        }
        layout {
            sequence: 50
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @vendor
            column: ADDRESS
            dataType: varchar2
        }
    )

    pageItem P15_CITY (
        type: textField
        label {
            label: Kota
            alignment: right
        }
        layout {
            sequence: 60
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @vendor
            column: CITY
            dataType: varchar2
        }
    )

    pageItem P15_CONTACT_PERSON (
        type: textField
        label {
            label: Contact Person
            alignment: right
        }
        layout {
            sequence: 70
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 100
        }
        source {
            formRegion: @vendor
            column: CONTACT_PERSON
            dataType: varchar2
        }
    )

    pageItem P15_PHONE (
        type: textField
        label {
            label: Telepon
            alignment: right
        }
        layout {
            sequence: 80
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 50
        }
        source {
            formRegion: @vendor
            column: PHONE
            dataType: varchar2
        }
    )

    pageItem P15_EMAIL (
        type: textField
        label {
            label: Email
            alignment: right
        }
        layout {
            sequence: 90
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 200
        }
        source {
            formRegion: @vendor
            column: EMAIL
            dataType: varchar2
        }
    )

    pageItem P15_PAYMENT_TERM_DAYS (
        type: numberField
        label {
            label: Payment Term (hari)
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 100
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @vendor
            column: PAYMENT_TERM_DAYS
            dataType: number
        }
        default {
            type: static
            staticValue: 30
        }
    )

    pageItem P15_ACTIVE_YN (
        type: selectList
        label {
            label: Aktif
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 110
            region: @vendor
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @vendor
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_VENDOR_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_VENDOR_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P15_VENDOR_ID is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form Vendor
        type: formInitialization
        formRegion: @vendor
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form Vendor
        type: formAutoRowProcessing
        formRegion: @vendor
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
    )

)
