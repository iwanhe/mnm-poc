page 41 (
    name: Purchase Requisition
    alias: PURCHASE-REQUISITION
    title: Purchase Requisition
    pageGroup: @procurement
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region purchase-requisition (
        name: Purchase Requisition
        type: form
        source {
            location: localDatabase
            tableName: PUR_REQUISITION
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P41_PR_ID (
        type: hidden
        layout {
            sequence: 5
            region: @purchase-requisition
            slot: regionBody
        }
        source {
            formRegion: @purchase-requisition
            column: PR_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P41_PR_NO (
        type: displayOnly
        label {
            label: No. PR
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 10
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @purchase-requisition
            column: PR_NO
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P41_STATUS (
        type: displayOnly
        label {
            label: Status
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @purchase-requisition
            column: STATUS
            dataType: varchar2
            queryOnly: true
        }
    )

    pageItem P41_BU_ID (
        type: selectList
        label {
            label: Business Unit
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @business-units
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 30
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @purchase-requisition
            column: BU_ID
            dataType: number
        }
    )

    pageItem P41_PR_DATE (
        type: datePicker
        label {
            label: Tanggal PR
            alignment: right
        }
        layout {
            sequence: 40
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @purchase-requisition
            column: PR_DATE
            dataType: date
        }
        default {
            type: sqlQuerySingleValue
            sqlQuerySingleValue: select trunc(sysdate) from dual
        }
    )

    pageItem P41_PURPOSE (
        type: selectList
        label {
            label: Tujuan Pembelian
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @pr-purposes
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 50
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @purchase-requisition
            column: PURPOSE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: STOCK
        }
    )

    pageItem P41_JOB_ID (
        type: selectList
        label {
            label: Job Order
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @open-jobs
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 60
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @purchase-requisition
            column: JOB_ID
            dataType: number
        }
        help {
            inlineHelpText: Wajib bila tujuan = Printing Job Order.
        }
    )

    pageItem P41_PROJECT_ID (
        type: selectList
        label {
            label: Proyek
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @open-projects
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 70
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @purchase-requisition
            column: PROJECT_ID
            dataType: number
        }
        help {
            inlineHelpText: Wajib bila tujuan = Engineering Project. Budget dicek saat Submit (BR-03).
        }
    )

    pageItem P41_WBS_ID (
        type: selectList
        label {
            label: WBS
            alignment: right
        }
        lov {
            type: sqlQuery
            sqlQuery: select wbs_code || ' - ' || wbs_name d, wbs_id r from prj_wbs where project_id = :P41_PROJECT_ID order by wbs_code
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        cascadingLov {
            parentItems: P41_PROJECT_ID
            parentRequired: false
        }
        layout {
            sequence: 80
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        source {
            formRegion: @purchase-requisition
            column: WBS_ID
            dataType: number
        }
    )

    pageItem P41_NEED_DATE (
        type: datePicker
        label {
            label: Tanggal Dibutuhkan
            alignment: right
        }
        layout {
            sequence: 90
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        source {
            formRegion: @purchase-requisition
            column: NEED_DATE
            dataType: date
        }
    )

    pageItem P41_DESCRIPTION (
        type: textarea
        label {
            label: Keterangan
            alignment: right
        }
        layout {
            sequence: 100
            region: @purchase-requisition
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 1000
        }
        source {
            formRegion: @purchase-requisition
            column: DESCRIPTION
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_PR_ID is not null and nvl(:P41_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_PR_ID is not null and nvl(:P41_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_PR_ID is null
        }
    )

    button submit (
        buttonName: SUBMIT
        label: Submit for Approval
        layout {
            sequence: 50
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
            requiresConfirmation: true
        }
        confirmation {
            message: Ajukan dokumen ini untuk approval? Setelah diajukan dokumen terkunci.
            style: information
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P41_PR_ID is not null and nvl(:P41_STATUS,'DRAFT') in ('DRAFT','REJECTED')
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    validation job-required (
        name: Job wajib untuk tujuan JOB
        execution {
            sequence: 10
        }
        validation {
            type: expression
            plsqlExpression: :P41_PURPOSE <> 'JOB' or :P41_JOB_ID is not null
        }
        error {
            errorMessage: Pilih Job Order untuk PR tujuan Printing Job Order.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P41_JOB_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,SUBMIT
        }
    )

    validation project-required (
        name: Proyek wajib untuk tujuan PROJECT
        execution {
            sequence: 20
        }
        validation {
            type: expression
            plsqlExpression: :P41_PURPOSE <> 'PROJECT' or :P41_PROJECT_ID is not null
        }
        error {
            errorMessage: Pilih Proyek untuk PR tujuan Engineering Project.
            displayLocation: inlineWithFieldAndInNotification
            associatedItem: @P41_PROJECT_ID
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,SUBMIT
        }
    )

    process initialize-form (
        name: Initialize form Purchase Requisition
        type: formInitialization
        formRegion: @purchase-requisition
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form Purchase Requisition
        type: formAutoRowProcessing
        formRegion: @purchase-requisition
        execution {
            sequence: 10
        }
    )

    process submit-for-approval (
        name: Submit for Approval
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                mbms_approval.submit(p_doc_type => 'PR', p_doc_id => :P41_PR_ID);
                ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Dokumen diajukan untuk approval.
        }
        serverSideCondition {
            whenButtonPressed: @submit
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE,SUBMIT
        }
    )

)
