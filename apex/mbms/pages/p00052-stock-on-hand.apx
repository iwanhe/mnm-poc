page 52 (
    name: Stock On Hand
    alias: STOCK-ON-HAND
    title: Stock On Hand
    pageGroup: @inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region stock-on-hand (
        name: Stock On Hand
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select bu_code, wh_code, wh_name, location_type, item_code, item_name, item_category, uom, min_stock,
                       qty_on_hand, avg_cost, stock_value, below_min_yn
                  from inv_stock_on_hand_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column BU_CODE (
            type: plainText
            heading {
                heading: BU
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        column WH_CODE (
            type: plainText
            heading {
                heading: Gudang/Lokasi
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column WH_NAME (
            type: plainText
            heading {
                heading: Nama Gudang
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column LOCATION_TYPE (
            type: plainText
            heading {
                heading: Tipe Lokasi
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Kode Item
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ITEM_NAME (
            type: plainText
            heading {
                heading: Nama Item
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column ITEM_CATEGORY (
            type: plainText
            heading {
                heading: Kategori
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: UoM
            }
            layout {
                sequence: 8
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: H
            }
        )

        column MIN_STOCK (
            type: plainText
            heading {
                heading: Min. Stok
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column QTY_ON_HAND (
            type: plainText
            heading {
                heading: On Hand
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column AVG_COST (
            type: plainText
            heading {
                heading: Biaya Rata-rata
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column STOCK_VALUE (
            type: plainText
            heading {
                heading: Nilai Stok
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column BELOW_MIN_YN (
            type: plainText
            heading {
                heading: Di Bawah Min?
            }
            layout {
                sequence: 13
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: M
            }
        )

        savedReport 52001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn BU_CODE (
                sequence: 1
            )

            displayColumn WH_CODE (
                sequence: 2
            )

            displayColumn WH_NAME (
                sequence: 3
            )

            displayColumn LOCATION_TYPE (
                sequence: 4
            )

            displayColumn ITEM_CODE (
                sequence: 5
            )

            displayColumn ITEM_NAME (
                sequence: 6
            )

            displayColumn ITEM_CATEGORY (
                sequence: 7
            )

            displayColumn UOM (
                sequence: 8
            )

            displayColumn MIN_STOCK (
                sequence: 9
            )

            displayColumn QTY_ON_HAND (
                sequence: 10
            )

            displayColumn AVG_COST (
                sequence: 11
            )

            displayColumn STOCK_VALUE (
                sequence: 12
            )

            displayColumn BELOW_MIN_YN (
                sequence: 13
            )

            sort (
                column: ITEM_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

)
