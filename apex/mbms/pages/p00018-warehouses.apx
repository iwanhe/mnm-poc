page 18 (
    name: Warehouses & Locations
    alias: WAREHOUSES
    title: Warehouses & Locations
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region warehouses (
        name: Warehouses & Locations
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select w.warehouse_id, w.wh_code, w.wh_name, bu.bu_code, w.location_type, w.active_yn
                  from mdm_warehouse w
                  join mdm_business_unit bu on bu.bu_id = w.bu_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 19
                items: {
                    P19_WAREHOUSE_ID: \#WAREHOUSE_ID#\
                }
                clearCache: 19
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column WAREHOUSE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column WH_CODE (
            type: plainText
            heading {
                heading: Kode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column WH_NAME (
            type: plainText
            heading {
                heading: Nama
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column BU_CODE (
            type: plainText
            heading {
                heading: BU
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column LOCATION_TYPE (
            type: plainText
            heading {
                heading: Tipe Lokasi
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 18001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn WH_CODE (
                sequence: 1
            )

            displayColumn WH_NAME (
                sequence: 2
            )

            displayColumn BU_CODE (
                sequence: 3
            )

            displayColumn LOCATION_TYPE (
                sequence: 4
            )

            displayColumn ACTIVE_YN (
                sequence: 5
            )

            sort (
                column: WH_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @warehouses
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 19
                clearCache: 19
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @warehouses
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @warehouses
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
