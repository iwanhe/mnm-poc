page 19 (
    name: Warehouse / Location
    alias: WAREHOUSE
    title: Warehouse / Location
    pageGroup: @master-data
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }
    security {
        authorizationScheme: @master-data-rights
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region warehouse (
        name: Warehouse / Location
        type: form
        source {
            location: localDatabase
            tableName: MDM_WAREHOUSE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P19_WAREHOUSE_ID (
        type: hidden
        layout {
            sequence: 5
            region: @warehouse
            slot: regionBody
        }
        source {
            formRegion: @warehouse
            column: WAREHOUSE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P19_WH_CODE (
        type: textField
        label {
            label: Kode Gudang/Lokasi
            alignment: right
        }
        layout {
            sequence: 10
            region: @warehouse
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 30
        }
        source {
            formRegion: @warehouse
            column: WH_CODE
            dataType: varchar2
        }
    )

    pageItem P19_WH_NAME (
        type: textField
        label {
            label: Nama
            alignment: right
        }
        layout {
            sequence: 20
            region: @warehouse
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
        source {
            formRegion: @warehouse
            column: WH_NAME
            dataType: varchar2
        }
    )

    pageItem P19_BU_ID (
        type: selectList
        label {
            label: Business Unit (pemilik)
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @business-units
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 30
            region: @warehouse
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @warehouse
            column: BU_ID
            dataType: number
        }
    )

    pageItem P19_LOCATION_TYPE (
        type: selectList
        label {
            label: Tipe Lokasi
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @location-types
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 40
            region: @warehouse
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @warehouse
            column: LOCATION_TYPE
            dataType: varchar2
        }
        default {
            type: static
            staticValue: MAIN
        }
        help {
            inlineHelpText: Site proyek dan vendor subkon dicatat sebagai lokasi di bawah gudang BU pemilik (D-04, BR-12).
        }
    )

    pageItem P19_ACTIVE_YN (
        type: selectList
        label {
            label: Aktif
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @yes-no
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 50
            region: @warehouse
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @warehouse
            column: ACTIVE_YN
            dataType: varchar2
        }
        default {
            type: static
            staticValue: Y
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P19_WAREHOUSE_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P19_WAREHOUSE_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P19_WAREHOUSE_ID is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form Warehouse / Location
        type: formInitialization
        formRegion: @warehouse
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form Warehouse / Location
        type: formAutoRowProcessing
        formRegion: @warehouse
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
    )

)
