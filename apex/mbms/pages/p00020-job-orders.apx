page 20 (
    name: Job Orders
    alias: JOB-ORDERS
    title: Job Orders
    pageGroup: @printing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region job-orders (
        name: Job Orders
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select j.job_id, j.job_no, j.job_type, c.customer_name, j.product_desc, j.qty_order, j.ups_per_sheet,
                       j.due_date, j.selling_price, j.est_hpp, j.status, j.created_by
                  from prt_job_order j
                  left join mdm_customer c on c.customer_id = j.customer_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 21
                items: {
                    P21_JOB_ID: \#JOB_ID#\
                }
                clearCache: 21
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column JOB_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column JOB_NO (
            type: plainText
            heading {
                heading: No. Job
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column JOB_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUCT_DESC (
            type: plainText
            heading {
                heading: Produk / Spesifikasi
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column QTY_ORDER (
            type: plainText
            heading {
                heading: Qty
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column UPS_PER_SHEET (
            type: plainText
            heading {
                heading: Up/Lembar
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column SELLING_PRICE (
            type: plainText
            heading {
                heading: Harga Jual
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column EST_HPP (
            type: plainText
            heading {
                heading: Est. HPP
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Dibuat Oleh
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        savedReport 20001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JOB_NO (
                sequence: 1
            )

            displayColumn JOB_TYPE (
                sequence: 2
            )

            displayColumn CUSTOMER_NAME (
                sequence: 3
            )

            displayColumn PRODUCT_DESC (
                sequence: 4
            )

            displayColumn QTY_ORDER (
                sequence: 5
            )

            displayColumn UPS_PER_SHEET (
                sequence: 6
            )

            displayColumn DUE_DATE (
                sequence: 7
            )

            displayColumn SELLING_PRICE (
                sequence: 8
            )

            displayColumn EST_HPP (
                sequence: 9
            )

            displayColumn STATUS (
                sequence: 10
            )

            displayColumn CREATED_BY (
                sequence: 11
            )

            sort (
                column: JOB_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @job-orders
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 21
                clearCache: 21
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @printing-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @job-orders
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @job-orders
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
