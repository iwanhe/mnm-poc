page 90 (
    name: Users & Roles
    alias: USERS-ROLES
    title: Users & Roles
    pageGroup: @administration
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        authorizationScheme: @admin-rights
    }
    help {
        helpText: Selama belum ada user dengan role ADMIN, semua user dianggap ADMIN (mode bootstrap). Daftarkan diri Anda sebagai ADMIN terlebih dahulu.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region users-roles (
        name: Users & Roles
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select ur.user_role_id, ur.username, ur.role_code, r.role_name, ur.created_by, ur.created_on
                  from sys_user_role ur
                  join sys_role r on r.role_code = ur.role_code
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 91
                items: {
                    P91_USER_ROLE_ID: \#USER_ROLE_ID#\
                }
                clearCache: 91
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column USER_ROLE_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column USERNAME (
            type: plainText
            heading {
                heading: Username
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ROLE_CODE (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ROLE_NAME (
            type: plainText
            heading {
                heading: Nama Role
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CREATED_BY (
            type: plainText
            heading {
                heading: Dibuat Oleh
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Dibuat
            }
            layout {
                sequence: 6
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: F
            }
        )

        savedReport 90001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn USERNAME (
                sequence: 1
            )

            displayColumn ROLE_CODE (
                sequence: 2
            )

            displayColumn ROLE_NAME (
                sequence: 3
            )

            displayColumn CREATED_BY (
                sequence: 4
            )

            displayColumn CREATED_ON (
                sequence: 5
            )

            sort (
                column: USERNAME
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @users-roles
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 91
                clearCache: 91
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @users-roles
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @users-roles
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
