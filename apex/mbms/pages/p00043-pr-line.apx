page 43 (
    name: PR Line
    alias: PR-LINE
    title: PR Line
    pageGroup: @procurement
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
        resizable: true
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
        settings {
            outputAs: text
        }
    )

    region pr-line (
        name: PR Line
        type: form
        source {
            location: localDatabase
            tableName: PUR_REQUISITION_LINE
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P43_LINE_ID (
        type: hidden
        layout {
            sequence: 5
            region: @pr-line
            slot: regionBody
        }
        source {
            formRegion: @pr-line
            column: LINE_ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P43_PR_ID (
        type: selectList
        label {
            label: No. PR (DRAFT/REJECTED)
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @editable-prs
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 10
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-line
            column: PR_ID
            dataType: number
        }
    )

    pageItem P43_LINE_NO (
        type: displayOnly
        label {
            label: No. Baris
            alignment: right
        }
        settings {
            sendOnPageSubmit: false
        }
        layout {
            sequence: 20
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        source {
            formRegion: @pr-line
            column: LINE_NO
            dataType: number
            queryOnly: true
        }
    )

    pageItem P43_ITEM_ID (
        type: selectList
        label {
            label: Item
            alignment: right
        }
        lov {
            type: sharedComponent
            lov: @items
            displayExtraValues: true
            displayNullValue: true
            nullDisplayValue: - Pilih -
        }
        layout {
            sequence: 30
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            height: 1
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-line
            column: ITEM_ID
            dataType: number
        }
    )

    pageItem P43_QTY (
        type: numberField
        label {
            label: Qty
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 40
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-line
            column: QTY
            dataType: number
        }
    )

    pageItem P43_UNIT_PRICE (
        type: numberField
        label {
            label: Estimasi Harga Satuan
            alignment: right
        }
        settings {
            numberAlignment: end
            virtualKeyboard: decimal
            minValue: 0
        }
        layout {
            sequence: 50
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            valueRequired: true
        }
        source {
            formRegion: @pr-line
            column: UNIT_PRICE
            dataType: number
        }
        default {
            type: static
            staticValue: 0
        }
    )

    pageItem P43_NOTES (
        type: textarea
        label {
            label: Catatan
            alignment: right
        }
        layout {
            sequence: 60
            region: @pr-line
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
            height: 3
        }
        validation {
            maxLength: 500
        }
        source {
            formRegion: @pr-line
            column: NOTES
            dataType: varchar2
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: [
                #DEFAULT#
                t-Button--danger
                t-Button--simple
            ]
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P43_LINE_ID is not null
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P43_LINE_ID is not null
        }
    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: expression
            plsqlExpression: :P43_LINE_ID is null
        }
    )

    dynamicAction cancel-dialog (
        name: Cancel Dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @cancel
        }

        action native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

    process initialize-form (
        name: Initialize form PR Line
        type: formInitialization
        formRegion: @pr-line
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    process process-form (
        name: Process form PR Line
        type: formAutoRowProcessing
        formRegion: @pr-line
        execution {
            sequence: 10
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        settings {
            showSuccessMessages: true
        }
        execution {
            sequence: 50
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: DELETE,SAVE,CREATE
        }
    )

)
