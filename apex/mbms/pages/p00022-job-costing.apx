page 22 (
    name: Job Costing (HPP)
    alias: JOB-COSTING
    title: Job Costing (HPP)
    pageGroup: @printing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText: Actual costing per job (D-07): HPP aktual = material yang di-issue (rata-rata biaya) + biaya aktual lain. Varians positif = penghematan.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region job-costing (
        name: Job Costing (HPP)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select job_id, job_no, job_type, customer_name, product_desc, status, due_date, qty_order, qty_produced,
                       qty_reject, qty_delivered, insheet_pct, waste_pct, selling_price, est_hpp, act_material,
                       act_other_cost, act_hpp, hpp_variance, est_gross_profit, act_gross_profit, act_margin_pct
                  from prt_job_cost_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column JOB_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column JOB_NO (
            type: plainText
            heading {
                heading: No. Job
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column JOB_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column PRODUCT_DESC (
            type: plainText
            heading {
                heading: Produk
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column DUE_DATE (
            type: plainText
            heading {
                heading: Due Date
            }
            layout {
                sequence: 7
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: G
            }
        )

        column QTY_ORDER (
            type: plainText
            heading {
                heading: Qty Order
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column QTY_PRODUCED (
            type: plainText
