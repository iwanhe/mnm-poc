        )

        savedReport 22001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn JOB_NO (
                sequence: 1
            )

            displayColumn JOB_TYPE (
                sequence: 2
            )

            displayColumn CUSTOMER_NAME (
                sequence: 3
            )

            displayColumn PRODUCT_DESC (
                sequence: 4
            )

            displayColumn STATUS (
                sequence: 5
            )

            displayColumn DUE_DATE (
                sequence: 6
            )

            displayColumn QTY_ORDER (
                sequence: 7
            )

            displayColumn QTY_PRODUCED (
                sequence: 8
            )

            displayColumn QTY_REJECT (
                sequence: 9
            )

            displayColumn QTY_DELIVERED (
                sequence: 10
            )

            displayColumn INSHEET_PCT (
                sequence: 11
            )

            displayColumn WASTE_PCT (
                sequence: 12
            )

            displayColumn SELLING_PRICE (
                sequence: 13
            )

            displayColumn EST_HPP (
                sequence: 14
            )

            displayColumn ACT_MATERIAL (
