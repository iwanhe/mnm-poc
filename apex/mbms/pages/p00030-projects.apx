page 30 (
    name: Projects
    alias: PROJECTS
    title: Projects
    pageGroup: @engineering
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region projects (
        name: Projects
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select p.project_id, p.project_no, p.project_name, p.project_type, c.customer_name, p.contract_value,
                       p.retention_pct, p.start_date, p.end_date, p.progress_pct, p.project_manager, p.status
                  from prj_project p
                  join mdm_customer c on c.customer_id = p.customer_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 31
                items: {
                    P31_PROJECT_ID: \#PROJECT_ID#\
                }
                clearCache: 31
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column PROJECT_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PROJECT_NO (
            type: link
            heading {
                heading: No. Proyek
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
            link {
                target: {
                    page: 32
                    items: {
                        IR_PROJECT_NO: #PROJECT_NO#
                    }
                    clearCache: 32
                    action: resetRegions
                }
                linkText: #PROJECT_NO#
            }
        )

        column PROJECT_NAME (
            type: plainText
            heading {
                heading: Nama Proyek
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PROJECT_TYPE (
            type: plainText
            heading {
                heading: Tipe
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column CONTRACT_VALUE (
            type: plainText
            heading {
                heading: Nilai Kontrak
                alignment: end
            }
            layout {
                sequence: 6
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: F
            }
        )

        column RETENTION_PCT (
            type: plainText
            heading {
                heading: Retensi %
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Mulai
            }
            layout {
                sequence: 8
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: H
            }
        )

        column END_DATE (
            type: plainText
            heading {
                heading: Target Selesai
            }
            layout {
                sequence: 9
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: I
            }
        )

        column PROGRESS_PCT (
            type: plainText
            heading {
                heading: Progres %
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column PROJECT_MANAGER (
            type: plainText
            heading {
                heading: PM
            }
            layout {
                sequence: 11
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: K
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 12
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: L
            }
        )

        savedReport 30001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROJECT_NO (
                sequence: 1
            )

            displayColumn PROJECT_NAME (
                sequence: 2
            )

            displayColumn PROJECT_TYPE (
                sequence: 3
            )

            displayColumn CUSTOMER_NAME (
                sequence: 4
            )

            displayColumn CONTRACT_VALUE (
                sequence: 5
            )

            displayColumn RETENTION_PCT (
                sequence: 6
            )

            displayColumn START_DATE (
                sequence: 7
            )

            displayColumn END_DATE (
                sequence: 8
            )

            displayColumn PROGRESS_PCT (
                sequence: 9
            )

            displayColumn PROJECT_MANAGER (
                sequence: 10
            )

            displayColumn STATUS (
                sequence: 11
            )

            sort (
                column: PROJECT_NO
                sort {
                    sequence: 1
                    direction: desc
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @projects
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 31
                clearCache: 31
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @engineering-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @projects
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @projects
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
