page 32 (
    name: WBS & Budget vs Actual
    alias: WBS-BUDGET
    title: WBS & Budget vs Actual
    pageGroup: @engineering
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    help {
        helpText: Varians positif berarti penghematan. Budget WBS hanya bisa diubah saat proyek DRAFT/REJECTED.
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region wbs-budget (
        name: WBS & Budget vs Actual
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select wbs_id, project_no, project_name, project_status, wbs_code, wbs_name, cost_category, budget_amount,
                       actual_amount, committed_amount, variance_amount, remaining_amount, used_pct
                  from prj_wbs_budget_v
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 33
                items: {
                    P33_WBS_ID: \#WBS_ID#\
                }
                clearCache: 33
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column WBS_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column PROJECT_NO (
            type: plainText
            heading {
                heading: No. Proyek
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column PROJECT_NAME (
            type: plainText
            heading {
                heading: Proyek
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column PROJECT_STATUS (
            type: plainText
            heading {
                heading: Status Proyek
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column WBS_CODE (
            type: plainText
            heading {
                heading: WBS
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column WBS_NAME (
            type: plainText
            heading {
                heading: Aktivitas
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column COST_CATEGORY (
            type: plainText
            heading {
                heading: Kategori Biaya
            }
            layout {
                sequence: 7
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: G
            }
        )

        column BUDGET_AMOUNT (
            type: plainText
            heading {
                heading: Budget
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTUAL_AMOUNT (
            type: plainText
            heading {
                heading: Aktual
                alignment: end
            }
            layout {
                sequence: 9
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: I
            }
        )

        column COMMITTED_AMOUNT (
            type: plainText
            heading {
                heading: Committed (PR)
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: J
            }
        )

        column VARIANCE_AMOUNT (
            type: plainText
            heading {
                heading: Varians
                alignment: end
            }
            layout {
                sequence: 11
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: K
            }
        )

        column REMAINING_AMOUNT (
            type: plainText
            heading {
                heading: Sisa Anggaran
                alignment: end
            }
            layout {
                sequence: 12
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: L
            }
        )

        column USED_PCT (
            type: plainText
            heading {
                heading: Terpakai %
                alignment: end
            }
            layout {
                sequence: 13
                columnAlignment: end
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: M
            }
        )

        savedReport 32001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn PROJECT_NO (
                sequence: 1
            )

            displayColumn PROJECT_NAME (
                sequence: 2
            )

            displayColumn PROJECT_STATUS (
                sequence: 3
            )

            displayColumn WBS_CODE (
                sequence: 4
            )

            displayColumn WBS_NAME (
                sequence: 5
            )

            displayColumn COST_CATEGORY (
                sequence: 6
            )

            displayColumn BUDGET_AMOUNT (
                sequence: 7
            )

            displayColumn ACTUAL_AMOUNT (
                sequence: 8
            )

            displayColumn COMMITTED_AMOUNT (
                sequence: 9
            )

            displayColumn VARIANCE_AMOUNT (
                sequence: 10
            )

            displayColumn REMAINING_AMOUNT (
                sequence: 11
            )

            displayColumn USED_PCT (
                sequence: 12
            )

            sort (
                column: WBS_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @wbs-budget
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 33
                clearCache: 33
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @engineering-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @wbs-budget
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @wbs-budget
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
