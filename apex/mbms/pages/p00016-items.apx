page 16 (
    name: Items
    alias: ITEMS
    title: Items
    pageGroup: @master-data
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region items (
        name: Items
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select i.item_id, i.item_code, i.item_name, i.item_category, i.uom, bu.bu_code, i.min_stock, i.std_cost, i.active_yn
                  from mdm_item i
                  left join mdm_business_unit bu on bu.bu_id = i.bu_id
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        link {
            linkColumn: customTarget
            target: {
                page: 17
                items: {
                    P17_ITEM_ID: \#ITEM_ID#\
                }
                clearCache: 17
            }
            linkIcon: <span aria-label="Edit"><span class="fa fa-edit" aria-hidden="true" title="Edit"></span></span>
        }
        pagination {
            type: rowRangesXToY
        }
        messages {
            whenNoDataFound: Tidak ada data.
        }
        actionsMenu {
            subscription: false
        }

        column ITEM_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 1
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: A
            }
        )

        column ITEM_CODE (
            type: plainText
            heading {
                heading: Kode
            }
            layout {
                sequence: 2
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: B
            }
        )

        column ITEM_NAME (
            type: plainText
            heading {
                heading: Nama Item
            }
            layout {
                sequence: 3
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column ITEM_CATEGORY (
            type: plainText
            heading {
                heading: Kategori
            }
            layout {
                sequence: 4
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column UOM (
            type: plainText
            heading {
                heading: UoM
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )

        column BU_CODE (
            type: plainText
            heading {
                heading: BU
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )

        column MIN_STOCK (
            type: plainText
            heading {
                heading: Min. Stok
                alignment: end
            }
            layout {
                sequence: 7
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G990D99
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: G
            }
        )

        column STD_COST (
            type: plainText
            heading {
                heading: Std Cost
                alignment: end
            }
            layout {
                sequence: 8
                columnAlignment: end
            }
            appearance {
                formatMask: 999G999G999G999G990
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: H
            }
        )

        column ACTIVE_YN (
            type: plainText
            heading {
                heading: Aktif
            }
            layout {
                sequence: 9
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: I
            }
        )

        savedReport 16001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ITEM_CODE (
                sequence: 1
            )

            displayColumn ITEM_NAME (
                sequence: 2
            )

            displayColumn ITEM_CATEGORY (
                sequence: 3
            )

            displayColumn UOM (
                sequence: 4
            )

            displayColumn BU_CODE (
                sequence: 5
            )

            displayColumn MIN_STOCK (
                sequence: 6
            )

            displayColumn STD_COST (
                sequence: 7
            )

            displayColumn ACTIVE_YN (
                sequence: 8
            )

            sort (
                column: ITEM_CODE
                sort {
                    sequence: 1
                }
            )

        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @items
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 17
                clearCache: 17
            }
            warnOnUnsavedChanges: doNotCheck
        }
        security {
            authorizationScheme: @master-data-rights
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @items
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @items
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)
