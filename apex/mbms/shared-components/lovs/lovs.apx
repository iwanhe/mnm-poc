lov business-units (
    name: MDM_BUSINESS_UNIT
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select bu_code || ' - ' || bu_name d, bu_id r
              from mdm_business_unit
             where active_yn = 'Y'
             order by bu_code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov customers (
    name: MDM_CUSTOMER
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select customer_code || ' - ' || customer_name d, customer_id r
              from mdm_customer
             where active_yn = 'Y'
             order by customer_name
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov items (
    name: MDM_ITEM
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select item_code || ' - ' || item_name || ' (' || uom || ')' d, item_id r
              from mdm_item
             where active_yn = 'Y'
             order by item_code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov warehouses (
    name: MDM_WAREHOUSE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select w.wh_code || ' - ' || w.wh_name d, w.warehouse_id r
              from mdm_warehouse w
             where w.active_yn = 'Y'
             order by w.wh_code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov open-jobs (
    name: PRT_JOB_ORDER (approved)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select job_no || ' - ' || substr(product_desc, 1, 60) d, job_id r
              from prt_job_order
             where status in ('APPROVED','IN_PROGRESS','COMPLETED')
             order by job_no desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov open-projects (
    name: PRJ_PROJECT (approved)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select project_no || ' - ' || project_name d, project_id r
              from prj_project
             where status in ('APPROVED','IN_PROGRESS','COMPLETED')
             order by project_no desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov draft-projects (
    name: PRJ_PROJECT (draft)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select project_no || ' - ' || project_name d, project_id r
              from prj_project
             where status in ('DRAFT','REJECTED')
             order by project_no desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov editable-prs (
    name: PUR_REQUISITION (draft)
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select pr_no || ' - ' || substr(description, 1, 60) d, pr_id r
              from pur_requisition
             where status in ('DRAFT','REJECTED')
             order by pr_no desc
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov roles (
    name: SYS_ROLE
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select role_code || ' - ' || role_name d, role_code r
              from sys_role
             order by role_code
            ```
    }
    columnMapping {
        return: R
        display: D
    }
)

lov doc-status (
    name: DOC_STATUS
    source {
        location: staticValues
    }

    entry draft (
        sequence: 10
        display: Draft
        return: DRAFT
    )

    entry submitted (
        sequence: 20
        display: Submitted
        return: SUBMITTED
    )

    entry approved (
        sequence: 30
        display: Approved
        return: APPROVED
    )

    entry rejected (
        sequence: 40
        display: Rejected
        return: REJECTED
    )

    entry in-progress (
        sequence: 50
        display: In Progress
        return: IN_PROGRESS
    )

    entry completed (
        sequence: 60
        display: Completed
        return: COMPLETED
    )

    entry closed (
        sequence: 70
        display: Closed
        return: CLOSED
    )

    entry cancelled (
        sequence: 80
        display: Cancelled
        return: CANCELLED
    )

)

